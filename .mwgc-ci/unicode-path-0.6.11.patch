+BOOST_AUTO_TEST_CASE(UnicodePathsDoNotUseTheWindowsLegacyCodePage) {
+    Directory files;
+    const auto data = files.path / fs::u8path("\xE6\xA8\xB9\xE6\x9C\xA8-\xF0\x9F\x8C\xBF");
+    const auto meshDirectory = data / fs::u8path("meshes/\xE8\x8D\x89");
+    const auto mesh = meshDirectory / "block.nif";
+    fs::create_directories(mesh.parent_path());
+    const auto bytes = widthModel(17);
+    std::ofstream stream(mesh, std::ios::binary);
+    stream.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    stream.close();
+    BOOST_REQUIRE(stream.good());
+
+    // An unrelated Unicode entry forces the directory index to enumerate a
+    // name that cannot be represented by many Windows legacy code pages.
+    fs::create_directories(data / fs::u8path("\xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E-\xE2\x98\x83"));
+    const auto config = files.text("unicode-openmw.cfg", dataLine(data));
+    SolidAssets assets(config, makeNullLogger());
+    const auto model = assets.get("\xE8\x8D\x89/block.nif");
+    BOOST_REQUIRE(model != nullptr);
+    BOOST_CHECK_EQUAL(model->collisionBounds.max.x, 17.0f);
+    BOOST_CHECK(assets.providerFor("\xE8\x8D\x89/block.nif").find("\xE6\xA8\xB9\xE6\x9C\xA8") != std::string::npos);
+}
